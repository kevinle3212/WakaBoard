# Backups taken before destructive edits; never committed
*.bak-*
*.tar.gz

# Rendered screens. The per-render PNGs are regenerated by `swift test --filter
# Snapshot` on demand and would rewrite fifty files on every design change; the
# contact sheets are the committed artefact a reviewer actually opens.
docs/screenshots/*.png
!docs/screenshots/contact-*.png

# Local working state
tmp/
NOTES.local.md
.claude/
.serena/
skill-observations/

# macOS
.DS_Store
